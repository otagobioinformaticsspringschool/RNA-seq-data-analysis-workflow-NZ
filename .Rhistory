library(limma)
library(edgeR)
library(dplyr)
dge <- DGEList(counts=counts.test)
dge <- calcNormFactors(dge)
dge <- normLibSizes(dge)
?normLibSizes
logCPM <- cpm(dge, log=TRUE, prior.count=3)
head(logCPM, 3)
View(coldata_subset_test)
design <- model.matrix(~histov3, data = coldata_subset_test)
