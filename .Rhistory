fcData <- read.delim("https://raw.githubusercontent.com/GenomicsAotearoa/RNA-seq-data-analysis-workflow/main/data/yeast_counts_all_chr.txt", comment.char="#")
View(fcData)
View(fcData)
fcData$Geneid
DEgenes <- head(fcData$Geneid, 1000)
genes <- head(fcData$Geneid, 1000)
rm(DEgenes)
background(fcData$Geneid)
background <- fcData$Geneid
DE.vector <- background %in% genes
DE.vector <-  DE.vector * 1
names(DE.vector) <-  background
sum(DE.vector) == length(genes)
sum(DE.vector) == length(genes) #test
genes
head(background)
#simulated gene lengths
set.seed(42)
geneLengths_sim <- data.frame(
GeneID = background,
Length = sample(100:2000, length(background), replace = TRUE)
)
View(geneLengths_sim)
geneLengths_sim <- data.frame(
GeneID = background,
Length = sample(100:3000, length(background), replace = TRUE)
)
#simulated gene lengths
set.seed(42)
geneLengths_sim <- data.frame(
GeneID = background,
Length = as.integer(round(rlnorm(length(background), meanlog = 6.5, sdlog = 0.8)))
)
# check range looks sensible
summary(geneLengths_sim$Length)
# sim length vec
length.vector <- setNames(geneLengths_sim$Length, geneLengths_sim$GeneID)
data.pwf <- nullp(DEgenes  = DE.vector,
bias.data = length.vector)   # your custom lengths
# Standard pipeline but with custom gene lengths
# Use case: your gene IDs match a supported org, but you want your own lengths
# e.g. you have union exon lengths from featureCounts rather than the defaults
library(goseq)
library(org.Sc.sgd.db)
BiocManager::install("org.Sc.sgd.db")
library(org.Sc.sgd.db)
data.pwf <- nullp(DEgenes  = DE.vector,
bias.data = length.vector)   # your custom lengths
go_output <- goseq(pwf    = data.pwf,
genome = "sacCer1",          # supported org genome
id     = "ensGene",          # supported org gene ID type
gene2cat = NULL)             # NULL = fetch GO terms automatically
View(go_output)
go_output_sim <- goseq(pwf    = data.pwf,
genome = "sacCer1",          # supported org genome
id     = "ensGene",          # supported org gene ID type
gene2cat = NULL)             # NULL = fetch GO terms automatically
rm(go_output)
data.pwf.sim <- nullp(DEgenes  = DE.vector,
bias.data = length.vector)   # your custom lengths
rm(data.pwf)
go_output_sim <- goseq(pwf    = data.pwf.sim,
genome = "sacCer1",          # supported org genome
id     = "ensGene",          # supported org gene ID type
gene2cat = NULL)             # NULL = fetch GO terms automatically
pwf <- nullp(genes, "sacCer1", "ensGene")
pwf <- nullp(DE.vector, "sacCer1", "ensGene")
go_output <-  goseq(pwf, "sacCer1", "ensGene")
View(go_output)
View(go_output_sim)
View(pwf)
View(data.pwf.sim)
library(vegan)
library(dplyr)
library(stringr)
library(purrr)
library(tidyr)
